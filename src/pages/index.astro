---
import Layout from '../layouts/Layout.astro';
import OfflineStatus from '../components/OfflineStatus.astro';
---

<Layout title="Malam Undian Merdeka">
  <div class="stage-container" data-role="stage" data-raffle-app>
    <div class="top-frame-line"></div>
    <div class="bottom-frame-line"></div>

    <button type="button" class="top-left-diamond" data-role="secret-reset" title="Operator Reset" aria-label="Operator Reset"></button>
    <div class="top-left-badge">GRIYA SHANTA &middot; RT 08</div>

    <canvas class="confetti-canvas" data-role="confetti-canvas"></canvas>
    <div class="forfeit-flash" data-role="forfeit-flash"></div>

    <div class="bg-red-split"></div>

    <div class="bg-cream-split">
      <svg class="sunburst-svg" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
        <g stroke="var(--color-gold)" stroke-width="2" opacity="0.65">
          <line x1="1000" y1="0" x2="300" y2="1000" />
          <line x1="1000" y1="0" x2="500" y2="1000" />
          <line x1="1000" y1="0" x2="700" y2="1000" />
          <line x1="1000" y1="0" x2="900" y2="1000" />
          <line x1="1000" y1="0" x2="0" y2="700" />
          <line x1="1000" y1="0" x2="0" y2="500" />
          <line x1="1000" y1="0" x2="0" y2="300" />
        </g>
      </svg>
    </div>

    <div class="wheel-wrapper">
      <svg class="wheel-svg" viewBox="0 0 500 500" data-role="wheel">
        <!-- Outermost decorative gold ring -->
        <circle cx="250" cy="250" r="247" fill="none" stroke="var(--color-gold)" stroke-width="2" />
        
        <!-- Outer Crimson Ring with Gold Outlines -->
        <circle cx="250" cy="250" r="236" fill="none" stroke="var(--color-crimson)" stroke-width="18" />
        <circle cx="250" cy="250" r="245" fill="none" stroke="var(--color-gold)" stroke-width="2" />
        <circle cx="250" cy="250" r="227" fill="none" stroke="var(--color-gold)" stroke-width="2" />

        <!-- 16 Wheel Slices (Black, Gold, Black, Green, Black, Red repeating) -->
        <g class="wheel-slices">
          <!-- Slice 0 (Black) -->
          <path d="M 250 250 L 206.1 29.32 A 225 225 0 0 1 293.9 29.32 Z" fill="var(--color-black)" stroke="var(--color-gold)" stroke-width="1.5" />
          <!-- Slice 1 (Gold) -->
          <path d="M 250 250 L 293.9 29.32 A 225 225 0 0 1 375 62.92 Z" fill="var(--color-gold)" stroke="var(--color-black)" stroke-width="1.5" />
          <!-- Slice 2 (Black) -->
          <path d="M 250 250 L 375 62.92 A 225 225 0 0 1 437.08 125 Z" fill="var(--color-black)" stroke="var(--color-gold)" stroke-width="1.5" />
          <!-- Slice 3 (Green) -->
          <path d="M 250 250 L 437.08 125 A 225 225 0 0 1 470.68 206.1 Z" fill="var(--color-green)" stroke="var(--color-gold)" stroke-width="1.5" />
          <!-- Slice 4 (Black) -->
          <path d="M 250 250 L 470.68 206.1 A 225 225 0 0 1 470.68 293.9 Z" fill="var(--color-black)" stroke="var(--color-gold)" stroke-width="1.5" />
          <!-- Slice 5 (Red) -->
          <path d="M 250 250 L 470.68 293.9 A 225 225 0 0 1 437.08 375 Z" fill="var(--color-crimson)" stroke="var(--color-gold)" stroke-width="1.5" />
          <!-- Slice 6 (Black) -->
          <path d="M 250 250 L 437.08 375 A 225 225 0 0 1 375 437.08 Z" fill="var(--color-black)" stroke="var(--color-gold)" stroke-width="1.5" />
          <!-- Slice 7 (Gold) -->
          <path d="M 250 250 L 375 437.08 A 225 225 0 0 1 293.9 470.68 Z" fill="var(--color-gold)" stroke="var(--color-black)" stroke-width="1.5" />
          <!-- Slice 8 (Black) -->
          <path d="M 250 250 L 293.9 470.68 A 225 225 0 0 1 206.1 470.68 Z" fill="var(--color-black)" stroke="var(--color-gold)" stroke-width="1.5" />
          <!-- Slice 9 (Green) -->
          <path d="M 250 250 L 206.1 470.68 A 225 225 0 0 1 125 437.08 Z" fill="var(--color-green)" stroke="var(--color-gold)" stroke-width="1.5" />
          <!-- Slice 10 (Black) -->
          <path d="M 250 250 L 125 437.08 A 225 225 0 0 1 62.92 375 Z" fill="var(--color-black)" stroke="var(--color-gold)" stroke-width="1.5" />
          <!-- Slice 11 (Red) -->
          <path d="M 250 250 L 62.92 375 A 225 225 0 0 1 29.32 293.9 Z" fill="var(--color-crimson)" stroke="var(--color-gold)" stroke-width="1.5" />
          <!-- Slice 12 (Black) -->
          <path d="M 250 250 L 29.32 293.9 A 225 225 0 0 1 29.32 206.1 Z" fill="var(--color-black)" stroke="var(--color-gold)" stroke-width="1.5" />
          <!-- Slice 13 (Gold) -->
          <path d="M 250 250 L 29.32 206.1 A 225 225 0 0 1 62.92 125 Z" fill="var(--color-gold)" stroke="var(--color-black)" stroke-width="1.5" />
          <!-- Slice 14 (Black) -->
          <path d="M 250 250 L 62.92 125 A 225 225 0 0 1 125 62.92 Z" fill="var(--color-black)" stroke="var(--color-gold)" stroke-width="1.5" />
          <!-- Slice 15 (Green) -->
          <path d="M 250 250 L 125 62.92 A 225 225 0 0 1 206.1 29.32 Z" fill="var(--color-green)" stroke="var(--color-gold)" stroke-width="1.5" />
        </g>

        <!-- Concentric Dividing Gold Ring across Slices -->
        <circle cx="250" cy="250" r="185" fill="none" stroke="var(--color-gold)" stroke-width="2" />

        <!-- Center Hub Black Disk with Gold Outline -->
        <circle cx="250" cy="250" r="148" fill="var(--color-black)" stroke="var(--color-gold)" stroke-width="4" />
      </svg>
      
      <div class="wheel-center-badge">
        <div class="badge-label">NOMOR TERKUNCI</div>
        <div class="badge-value" data-role="winner-display">???</div>
        <div class="badge-footer">PEMENANG</div>
      </div>
      <svg class="diamond-pointer" viewBox="0 0 100 100">
        <polygon points="10,0 90,0 50,70" fill="var(--color-white)" stroke="var(--color-black)" stroke-width="4"/>
        <polygon points="30,0 70,0 50,35" fill="var(--color-cream)" stroke="var(--color-black)" stroke-width="2"/>
      </svg>
    </div>

    <div class="bottom-left-text">sekali putar, satu pemenang!</div>

    <div class="top-right-stats">
      <div class="round-badge" data-role="round-badge">BABAK HADIAH HIBURAN</div>
      <button type="button" class="switch-round-btn" data-role="switch-round-button" hidden>🏆 Babak Utama ➔</button>
      <button type="button" class="mute-toggle-btn" data-role="mute-button" title="Toggle Suara (M)">🔊 SUARA AKTIF</button>
      <span class="stat-gold" data-role="active-count">164 NOMOR TERSISA</span>
      <span class="stat-cream" data-role="prize-position">HADIAH 02/05</span>
    </div>

    <div class="ransom-title">
      <span class="word block-1">MALAM</span>
      <span class="word block-2">UNDIAN</span>
      <span class="word block-3">MERDEKA!</span>
    </div>

    <div class="middle-right-text">PUTAR RODA. TAHAN NAPAS.<br><span class="highlight">BIARKAN NASIB MEMILIH</span> SATU<br>NOMOR KAVLING MALAM INI.</div>

    <div class="error-message" data-role="error" hidden style="position: absolute; top: 5%; right: 10%; color: var(--color-crimson); font-weight: bold; z-index: 15;"></div>

    <div class="bottom-right-controls">
      <div class="primary-actions">
        <button class="skew-btn" data-role="spin-button">
          PUTAR SEKARANG
          <span class="btn-arrow" aria-hidden="true">&#9654;</span>
        </button>
        <button class="forfeit-btn" data-role="forfeit-button" hidden>HANGUS & UNDI ULANG</button>
      </div>
      <div class="btn-subtext">ENTER - MULAI UNDIAN</div>
    </div>

    <div class="bottom-right-diamond">
      <OfflineStatus />
    </div>

    <button class="skew-btn-secondary" data-role="reset-button" hidden>RESET</button>

    <dialog data-role="reset-dialog" style="background: var(--color-cream); border: 4px solid var(--color-gold); border-radius: 12px; padding: 20px; text-align: center; z-index: 100;">
      <h2 id="reset-title" style="font-family: var(--font-heavy); color: var(--color-black); margin-top: 0;">Reset seluruh undian?</h2>
      <p style="font-family: var(--font-condensed); color: var(--color-black);">Semua pemenang akan dihapus dan seluruh nomor kavling kembali masuk undian.</p>
      <button type="button" class="skew-btn-secondary" data-role="reset-cancel" style="position: static; margin-right: 10px;">Batal</button>
      <button type="button" class="skew-btn" data-role="reset-confirm" style="position: static;">Yakin</button>
    </dialog>

    <dialog data-role="intermission-dialog" class="intermission-dialog">
      <div class="intermission-content">
        <h2 class="intermission-title">🏆 BABAK HADIAH HIBURAN SELESAI!</h2>
        <p class="intermission-desc">Daftar Pemenang Hadiah Hiburan:</p>
        <div data-role="intermission-winners" class="intermission-winners-list"></div>
        <p class="intermission-notice">Perhatian: Seluruh 164 nomor kavling akan di-reset penuh untuk Babak Hadiah Utama!</p>
        <div class="intermission-actions">
          <button type="button" class="skew-btn" data-role="start-main-round-btn">🔥 MULAI BABAK HADIAH UTAMA</button>
        </div>
      </div>
    </dialog>

    <div class="winner-history-container" data-role="winner-history" style="position: absolute; bottom: 20%; right: 10%; max-height: 25%; overflow-y: auto; font-family: var(--font-condensed); font-size: 1.2vw; color: var(--color-black); z-index: 15;" hidden></div>

    <div class="finale-overlay" data-role="finale-overlay" hidden>
      <div class="finale-title">SELURUH HADIAH TELAH DIUNDI!</div>
      <div class="finale-subtitle">MALAM PUNCAK HUT RI KE-81</div>
      <div class="finale-columns">
        <div class="finale-column">
          <h3 class="finale-column-title">🎁 HADIAH HIBURAN</h3>
          <div class="finale-winners-list" data-role="finale-small-winners"></div>
        </div>
        <div class="finale-column">
          <h3 class="finale-column-title">🏆 HADIAH UTAMA</h3>
          <div class="finale-winners-list" data-role="finale-main-winners"></div>
        </div>
      </div>
      <div class="finale-actions">
        <button type="button" class="skew-btn-secondary" data-role="finale-reset-btn">🔄 RESET SELURUH ACARA</button>
        <button type="button" class="skew-btn" data-role="finale-close-btn">👁️ TUTUP OVERLAY</button>
      </div>
      <div class="finale-greeting">Dirgahayu Republik Indonesia ke-81 &mdash; Griya Shanta RT 08</div>
    </div>
  </div>
  <script src="../client/raffle-controller.ts"></script>
</Layout>


