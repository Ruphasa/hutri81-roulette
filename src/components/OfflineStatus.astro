<div class="offline-dot-container" aria-live="polite" data-role="offline-status" data-state="unready">
  <span class="offline-dot" aria-hidden="true"></span>
  <span class="sr-only" data-role="offline-status-text">Belum Siap Offline</span>
</div>

<style>
  .offline-dot-container {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: rotate(-45deg);
  }

  .offline-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: transparent;
    transition: background-color 0.3s, box-shadow 0.3s;
  }

  .offline-dot-container[data-state="ready"] .offline-dot {
    background-color: var(--color-crimson);
    box-shadow: 0 0 8px var(--color-crimson);
  }

  .offline-dot-container[data-state="update-available"] .offline-dot {
    background-color: var(--color-gold);
    box-shadow: 0 0 8px var(--color-gold);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>

<script>
  import { bindOfflineStatus } from '../client/offline-status';

  const statusElements = document.querySelectorAll<HTMLElement>('[data-role="offline-status"]');
  statusElements.forEach((el) => {
    bindOfflineStatus(el);
  });
</script>
