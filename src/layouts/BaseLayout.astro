---
import '@fontsource/limelight';
import '@fontsource/bowlby-one-sc';
import '@fontsource/barlow-condensed';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string | undefined;
  bodyClass?: string | undefined;
}

const { title, description = 'Undian Offline HUT RI - PWA', bodyClass } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e12631" />
    <link rel="icon" type="image/svg+xml" href="/brand-icon.svg" />
    <link rel="apple-touch-icon" href="/icons/pwa-192x192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <slot />
    <script>
      import { initPWARegistration } from '../client/offline-status';
      initPWARegistration();
    </script>
  </body>
</html>
